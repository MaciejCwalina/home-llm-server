  {
   "type": "timeseries",
   "title": "Time since last successful scrape",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - stream_hub_sampler_last_success_seconds{source=\"vllm\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "vLLM sampler"
    },
    {
     "refId": "B",
     "expr": "time() - stream_hub_sampler_last_success_seconds{source=\"gpu\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "GPU sampler"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
