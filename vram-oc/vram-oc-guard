#!/usr/bin/env python3
"""Apply a GDDR7 memory clock offset to every GPU and guard it.

- Enables persistence mode so the driver keeps the offset while no process uses the GPUs.
- Applies OFFSET_MHZ (from /etc/default/vram-oc) through NVML.
  OC_MODE=always keeps it applied all the time. OC_MODE=on-demand applies it only while vLLM has running or
  waiting requests and returns to stock after IDLE_SECONDS without any, so the GPUs never drop into or wake
  from their idle memory clock with the overclock applied (suspected trigger of the drafter corruption).
  Request state is streamed from stream-hub (WS /stream, vllm.running/vllm.waiting every 200 ms); if the
  stream goes quiet for STREAM_TIMEOUT_SECONDS the GPUs go back to stock.
- Every second counts NVIDIA Xid errors in the kernel log. On a new Xid it resets every GPU to stock (offset 0)
  and stays at stock until the service is restarted by hand.
- Writes Prometheus metrics for node exporter's textfile collector.
- On stop it resets the offset to 0.
"""
import asyncio
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.request

import pynvml as nvml

OFFSET_MHZ = int(os.environ.get("OFFSET_MHZ", "0"))
TEXTFILE = "/var/lib/node_exporter/textfile/vram_oc.prom"
HUB_URL = os.environ.get("STREAM_HUB_URL", "http://127.0.0.1:9797/push")
OC_MODE = os.environ.get("OC_MODE", "always")
IDLE_SECONDS = float(os.environ.get("IDLE_SECONDS", "3"))
STREAM_URL = os.environ.get("STREAM_HUB_STREAM_URL", "ws://127.0.0.1:9797/stream?metrics=vllm.running,vllm.waiting")
STREAM_TIMEOUT_SECONDS = 2
INTERVAL_SECONDS = 1


def set_offset(offset):
    for index in range(nvml.nvmlDeviceGetCount()):
        nvml.nvmlDeviceSetMemClkVfOffset(nvml.nvmlDeviceGetHandleByIndex(index), offset)


class RequestStream:
    """Follows vLLM's running/waiting request counts streamed by stream-hub, in a background thread."""

    def __init__(self):
        self.last_busy = 0.0
        self.last_message = 0.0
        self.counts = {"vllm.running": 0.0, "vllm.waiting": 0.0}
        self.changed = threading.Event()
        threading.Thread(target=lambda: asyncio.run(self.follow()), daemon=True).start()

    async def follow(self):
        import websockets

        while True:
            try:
                async with websockets.connect(STREAM_URL, open_timeout=5) as connection:
                    async for raw_message in connection:
                        message = json.loads(raw_message)
                        if message.get("type") != "update":
                            continue  # the snapshot is history, not the current state
                        for metric, _, value in message["data"]:
                            self.counts[metric] = value
                        now = time.monotonic()
                        self.last_message = now
                        # vllm.waiting is only sent while > 0, so it decays with running's heartbeat
                        if not any(metric == "vllm.waiting" for metric, _, _ in message["data"]):
                            self.counts["vllm.waiting"] = 0.0
                        if sum(self.counts.values()) > 0:
                            self.last_busy = now
                            self.changed.set()
            except Exception:
                await asyncio.sleep(1)

    def busy(self, now):
        return now - self.last_message < STREAM_TIMEOUT_SECONDS and now - self.last_busy < IDLE_SECONDS


def xid_count():
    kernel_log = subprocess.run(["dmesg"], capture_output=True, text=True).stdout
    return len(re.findall(r"NVRM: Xid", kernel_log))


def push_to_hub(offset, xid_errors, tripped):
    """Push event metrics to the stream-hub so Grafana sees changes instantly."""
    payload = json.dumps(
        [
            {"metric": "vram_oc.offset_mhz", "value": float(offset)},
            {"metric": "vram_oc.xid_errors", "value": float(xid_errors)},
            {"metric": "vram_oc.tripped", "value": float(tripped)},
        ]
    ).encode()
    request = urllib.request.Request(HUB_URL, data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=1) as response:
            response.read()
    except Exception:
        pass  # hub down: textfile collector still covers Prometheus


def write_metrics(offset, xid_errors, tripped, switches=0):
    temporary = TEXTFILE + ".tmp"
    with open(temporary, "w") as handle:
        handle.write("# HELP vram_oc_offset_mhz Memory clock offset currently applied (NVML units).\n# TYPE vram_oc_offset_mhz gauge\n")
        handle.write(f"vram_oc_offset_mhz {offset}\n")
        handle.write("# HELP vram_oc_xid_errors_total NVIDIA Xid errors in the kernel log since boot.\n# TYPE vram_oc_xid_errors_total counter\n")
        handle.write(f"vram_oc_xid_errors_total {xid_errors}\n")
        handle.write("# HELP vram_oc_tripped 1 when the watchdog reset the GPUs to stock after an Xid error.\n# TYPE vram_oc_tripped gauge\n")
        handle.write(f"vram_oc_tripped {int(tripped)}\n")
        handle.write("# HELP vram_oc_switches_total Times the offset was applied or removed (on-demand mode).\n# TYPE vram_oc_switches_total counter\n")
        handle.write(f"vram_oc_switches_total {switches}\n")
    os.replace(temporary, TEXTFILE)
    push_to_hub(offset, xid_errors, tripped)


def main():
    os.makedirs(os.path.dirname(TEXTFILE), exist_ok=True)
    subprocess.run(["nvidia-smi", "-pm", "1"], capture_output=True)
    nvml.nvmlInit()

    def stop(*_):
        set_offset(0)
        write_metrics(0, xid_count(), False)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    baseline_xid = xid_count()
    if baseline_xid:
        print(f"{baseline_xid} Xid error(s) already in the kernel log; staying at stock", flush=True)
        offset, tripped = 0, True
    else:
        offset, tripped = (OFFSET_MHZ if OC_MODE == "always" else 0), False
    set_offset(offset)
    print(f"mode {OC_MODE}: memory offset +{offset} MHz applied to {nvml.nvmlDeviceGetCount()} GPUs", flush=True)

    stream = RequestStream() if OC_MODE == "on-demand" else None
    switches, last_check = 0, 0.0
    current_xid = baseline_xid
    while True:
        now = time.monotonic()
        if stream and not tripped:
            wanted = OFFSET_MHZ if stream.busy(now) else 0
            if wanted != offset:
                set_offset(wanted)
                offset, switches = wanted, switches + 1
                write_metrics(offset, current_xid, tripped, switches)
        if now - last_check >= INTERVAL_SECONDS:
            last_check = now
            current_xid = xid_count()
            if current_xid > baseline_xid and not tripped:
                set_offset(0)
                offset, tripped = 0, True
                print(f"Xid error detected ({current_xid} total): reset all GPUs to stock memory clock", flush=True)
            write_metrics(offset, current_xid, tripped, switches)
        if stream:
            # wakes the moment the stream reports a request; the timeout only drives the idle/Xid checks
            stream.changed.wait(timeout=0.5)
            stream.changed.clear()
        else:
            time.sleep(INTERVAL_SECONDS)


if __name__ == "__main__":
    main()
